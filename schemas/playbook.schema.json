{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibos.dev/schemas/playbook.schema.json",

  "title": "Playbook",
  "description": "AIBOS Playbook Resource",

  "type": "object",

  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^aibos\\.dev/v[0-9]+$"
    },

    "kind": {
      "const": "Playbook"
    },

    "metadata": {
      "type": "object",

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },

        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },

      "required": [
        "name"
      ],

      "unevaluatedProperties": false
    },

    "spec": {
      "type": "object",

      "properties": {
        "description": {
          "type": "string"
        },

        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "steps": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",

            "properties": {
              "name": {
                "type": "string"
              },

              "worker": {
                "type": "string"
              },

              "action": {
                "type": "string"
              },

              "input": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },

              "output": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },

            "required": [
              "name",
              "worker",
              "action"
            ],

            "unevaluatedProperties": false
          }
        },

        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },

      "required": [
        "steps"
      ],

      "unevaluatedProperties": false
    }
  },

  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],

  "unevaluatedProperties": false
}