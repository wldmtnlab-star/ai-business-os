{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibos.dev/schemas/worker.schema.json",

  "title": "Worker",
  "description": "AIBOS Worker Resource",

  "type": "object",

  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^aibos\\.dev/v[0-9]+$"
    },

    "kind": {
      "const": "Worker"
    },

    "metadata": {
      "type": "object",

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },

        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },

      "required": [
        "name"
      ],

      "unevaluatedProperties": false
    },

    "spec": {
      "type": "object",

      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },

        "goal": {
          "type": "string",
          "minLength": 1
        },

        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "knowledge": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "input": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },

        "output": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },

      "required": [
        "role",
        "goal"
      ],

      "unevaluatedProperties": false
    }
  },

  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],

  "unevaluatedProperties": false
}