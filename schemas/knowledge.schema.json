{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibos.dev/schemas/knowledge.schema.json",

  "title": "Knowledge",
  "description": "AIBOS Knowledge Resource",

  "type": "object",

  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^aibos\\.dev/v[0-9]+$"
    },

    "kind": {
      "const": "Knowledge"
    },

    "metadata": {
      "type": "object",

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },

        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },

      "required": [
        "name"
      ],

      "unevaluatedProperties": false
    },

    "content": {
      "type": "string",
      "minLength": 1
    }
  },

  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "content"
  ],

  "unevaluatedProperties": false
}