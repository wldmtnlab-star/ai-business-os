{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibos.dev/schemas/organization.schema.json",

  "title": "Organization",
  "description": "AIBOS Organization Resource",

  "type": "object",

  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^aibos\\.dev/v[0-9]+$"
    },

    "kind": {
      "const": "Organization"
    },

    "metadata": {
      "type": "object",

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },

        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },

      "required": [
        "name"
      ],

      "unevaluatedProperties": false
    },

    "spec": {
      "type": "object",

      "properties": {
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "workers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "playbooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },

      "required": [
        "knowledge",
        "workers",
        "playbooks"
      ],

      "unevaluatedProperties": false
    },

    "runtime": {
      "type": "object",

      "properties": {
        "provider": {
          "type": "string"
        },

        "model": {
          "type": "string"
        },

        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },

      "required": [
        "provider",
        "model"
      ],

      "unevaluatedProperties": false
    }
  },

  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],

  "unevaluatedProperties": false
}